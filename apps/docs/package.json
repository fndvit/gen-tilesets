    "starlight-typedoc": "^0.23.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typescript": "^5.7.0"
