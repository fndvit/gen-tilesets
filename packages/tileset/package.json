{
  "name": "@fndvit/gen-tilesets",
  "version": "0.8.1",
  "description": "Procedural tileset generator: a pure, deterministic engine and a Svelte renderer.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fndvit/gen-tilesets.git",
    "directory": "packages/tileset"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./render": {
      "types": "./src/render/index.ts",
      "svelte": "./src/render/index.ts",
      "default": "./src/render/index.ts"
    },
    "./Tileset.svelte": {
      "types": "./src/render/Tileset.svelte",
      "svelte": "./src/render/Tileset.svelte",
      "default": "./src/render/Tileset.svelte"
    },
    "./TileDecoration.svelte": {
      "types": "./src/render/TileDecoration.svelte",
      "svelte": "./src/render/TileDecoration.svelte",
      "default": "./src/render/TileDecoration.svelte"
    }
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "svelte": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./render": {
        "types": "./dist/render/index.d.ts",
        "svelte": "./dist/render/index.js",
        "default": "./dist/render/index.js"
      },
      "./Tileset.svelte": {
        "types": "./dist/render/Tileset.svelte.d.ts",
        "svelte": "./dist/render/Tileset.svelte",
        "default": "./dist/render/Tileset.svelte"
      },
      "./TileDecoration.svelte": {
        "types": "./dist/render/TileDecoration.svelte.d.ts",
        "svelte": "./dist/render/TileDecoration.svelte",
        "default": "./dist/render/TileDecoration.svelte"
      }
    }
  },
  "peerDependencies": {
    "svelte": "^5.20.0"
  },
  "scripts": {
    "build": "svelte-package --input src --output dist && pnpm run build:prune",
    "build:prune": "find dist -name \"*.test.*\" -delete && rm -rf .svelte-kit",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "prepublishOnly": "pnpm test && pnpm typecheck && pnpm build"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.4",
    "svelte": "^5.56.8",
    "svelte-check": "^4.1.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
